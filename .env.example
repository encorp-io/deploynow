# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret"

# ── Optional ──────────────────────────────────────────────────────────────────
# Admin credentials created on first boot (default: admin@encorp.io / admin)
ADMIN_EMAIL=admin@encorp.io
ADMIN_PASSWORD=admin

# Public URL of the deployer (used for invite links)
NEXTAUTH_URL=http://localhost:3000

# SQLite database path (volume-mounted in Docker)
DATABASE_URL="file:/data/deployer.db"
