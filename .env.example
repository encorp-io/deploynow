# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret"

# Admin password is required on first boot (min 12 characters)
ADMIN_PASSWORD="change-me-strong-password"

# ── Optional ──────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com

# Image tag: a release such as 2.0.0 (recommended), latest (newest stable) or edge (main)
# DEPLOYNOW_TAG=latest

# GitHub Enterprise hosts that may receive the Settings GitHub token when cloning
# (github.com always may), comma separated
# GITHUB_HOSTS=git.example.com

# Public URL of the deployer (used for invite links).
# Set to your server's actual URL, e.g. https://164.90.232.75:9444
# If unset, the URL is derived from the incoming request headers automatically.
# NEXTAUTH_URL=https://your-server:9444

# SQLite database path (inside the /data volume)
DATABASE_URL="file:/data/deployer.db"

# ── Docker access (v2) ────────────────────────────────────────────────────────
# v2 talks to Docker directly; Portainer is not needed. To manage the machine the
# deployer runs on, mount /var/run/docker.sock and give the container its group:
#   DOCKER_GID=$(stat -c %g /var/run/docker.sock)
# Remote machines are added in the UI over SSH or TLS.
# DOCKER_GID=999

# Console WebSocket. nginx proxies /ws/ to it inside the container; only change
# these for local development (e.g. WS_PUBLIC_PATH=ws://localhost:3002/ws/exec).
# WS_PORT=3002
# WS_PUBLIC_PATH=/ws/exec
# WS_ALLOWED_ORIGIN=http://localhost:3000   # dev only, when the page and socket ports differ

# ── GitHub Container Registry (optional — can also configure via web UI) ──────
# Your GitHub username + Personal Access Token with read:packages scope
# GITHUB_USER=your-github-username
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# ── Container Health Monitor (optional) ──────────────────────────────────────
# Webhook URL to POST to after a container is auto-restarted.
# Payload: { container, pattern, restartedAt, logWindow }
# HEALTH_MONITOR_WEBHOOK_URL=https://your-n8n-instance/webhook/xxxx

# ── TLS / HTTPS ───────────────────────────────────────────────────────────────
# By default a self-signed certificate is auto-generated into /data/certs/
# on first boot and reused on subsequent starts.
#
# Option A: Mount a real cert at /certs/ in docker-compose.yml (no env needed)
#
# Option B: Point to cert files in a mounted volume via env vars:
# CERT_FILE=/certs/cert.pem
# KEY_FILE=/certs/key.pem
#
# Option C: Custom hostname for the self-signed cert SAN (cosmetic only):
# TLS_HOSTNAME=deployer.yourcompany.com
