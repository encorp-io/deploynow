generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("member") // admin, member
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invites TeamInvite[]
}

model TeamInvite {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  role      String   @default("member")
  expiresAt DateTime
  used      Boolean  @default(false)
  createdBy String
  creator   User     @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
}

model Settings {
  id                  String  @id @default("singleton")
  portainerUrl        String  @default("")
  portainerApiKey     String  @default("") // AES-256-GCM encrypted at rest
  githubUser          String  @default("") // GitHub username for GHCR auth
  githubToken         String  @default("") // AES-256-GCM encrypted at rest
  pollingInterval     Int     @default(60) // seconds, range 30–3600
  autoUpdateLatest    Boolean @default(true)
  portainerEndpointId Int     @default(1)  // which Portainer environment to manage
}

model Service {
  id              String   @id @default(cuid())
  containerId     String   @unique
  containerName   String
  image           String   // full image ref e.g. ghcr.io/org/repo:tag
  registry        String   @default("ghcr.io")
  currentDigest   String   @default("")
  remoteDigest    String   @default("")
  tag             String   @default("latest")
  isFloatingTag   Boolean  @default(true) // true = auto-update, false = notify only
  arch            String   @default("amd64")   // image architecture: amd64, arm64, etc.
  status          String   @default("unknown") // running, stopped, updating, error
  updateAvailable Boolean  @default(false)
  portainerEndpointId Int      @default(1)
  lastChecked     DateTime?
  lastUpdated     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  serviceId String?
  action    String   // check, update, error, manual_update
  message   String
  details   String   @default("")
  createdAt DateTime @default(now())
}
