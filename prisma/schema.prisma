generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Identity & access ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String // scrypt$… (v2) or bcrypt (v1, rehashed on next login)
  // Instance-wide role: owner, admin, operator, viewer.
  // v1 values (admin, member) are remapped by the v2 upgrade step.
  role          String    @default("operator")
  totpSecret    String    @default("") // AES-256-GCM encrypted base32 secret
  totpPending   String    @default("") // encrypted secret during enrolment, before first code is confirmed
  totpEnabledAt DateTime?
  totpLastStep  Int       @default(0) // last accepted TOTP time step (replay protection)
  disabledAt    DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  invites       TeamInvite[]
  sessions      Session[]
  recoveryCodes RecoveryCode[]
  roleBindings  RoleBinding[]
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String // sha256 of the normalised code
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Server-side session record. The NextAuth JWT carries only its id (sid), so a
// session can be listed and revoked, and role changes apply on the next request.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String    @default("")
  userAgent  String    @default("")
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  stepUpAt   DateTime? // last time the user re-confirmed a 2FA code for a sensitive action

  @@index([userId])
}

// Extra grant on top of the user's instance role, scoped to one endpoint
// (and, from phase 2, one project). The effective role is the higher of the two.
model RoleBinding {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // admin, operator, viewer
  scopeType String // endpoint, project
  scopeId   String
  createdAt DateTime @default(now())

  @@unique([userId, scopeType, scopeId])
}

model TeamInvite {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  role      String   @default("operator")
  expiresAt DateTime
  used      Boolean  @default(false)
  createdBy String
  creator   User     @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
}

// Persistent login throttle (survives restarts, unlike the v1 in-memory map)
model LoginThrottle {
  key          String    @id
  count        Int       @default(0)
  firstAttempt DateTime  @default(now())
  lockedUntil  DateTime?
}

// ─── Machines ─────────────────────────────────────────────────────────────────

model Endpoint {
  id                 String    @id @default(cuid())
  name               String    @unique
  type               String // socket, ssh, tls
  // socket: path to the Docker socket; ssh/tls: hostname or IP
  host               String
  port               Int?
  username           String    @default("") // ssh user
  credentials        String    @default("") // AES-256-GCM encrypted JSON: privateKey, passphrase, ca, cert, key
  // ssh: SHA256 fingerprint of the host key, pinned on first successful connect
  hostKeyFingerprint String    @default("")
  labels             String    @default("") // comma-separated, e.g. "prod,client-a"
  status             String    @default("unknown") // online, offline, unknown
  dockerVersion      String    @default("")
  os                 String    @default("")
  cpus               Int       @default(0)
  memoryBytes        Float     @default(0)
  containers         Int       @default(0)
  lastSeenAt         DateTime?
  lastError          String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Edge proxy (Traefik) that routes app domains and gets Let's Encrypt certificates.
  // managed = DeployNow runs its own Traefik; external = an existing Traefik
  // (e.g. Dokploy's) on proxyNetwork with entrypoints web/websecure and a
  // "letsencrypt" resolver; none = no domains on this endpoint.
  proxyMode    String @default("none")
  proxyNetwork String @default("deploynow")
  proxyEmail   String @default("")
  proxyError   String @default("")

  services     Service[]
  applications Application[]
  environments Environment[]
}

// ─── Settings ─────────────────────────────────────────────────────────────────

model Settings {
  id                  String  @id @default("singleton")
  schemaVersion       Int     @default(1)
  githubUser          String  @default("") // GitHub username for GHCR auth
  githubToken         String  @default("") // AES-256-GCM encrypted at rest
  pollingInterval     Int     @default(60) // seconds, range 30–3600
  autoUpdateLatest    Boolean @default(false)
  require2faForAdmins Boolean @default(true)
  // Optional HashiCorp Vault: env vars of kind "vault" hold <mount>/<path>#<field>
  vaultAddr           String  @default("") // https://vault.example.com:8200
  vaultNamespace      String  @default("") // Vault Enterprise / HCP namespace
  vaultAuth           String  @default("token") // token, approle
  vaultToken          String  @default("") // encrypted
  vaultRoleId         String  @default("")
  vaultSecretId       String  @default("") // encrypted
  vaultCaCert         String  @default("") // PEM, for a private CA
  // ── v1 legacy (read once by the v2 upgrade step, no longer used) ──
  portainerUrl        String  @default("")
  portainerApiKey     String  @default("")
  portainerEndpointId Int     @default(1)
}

// A container tracked for image updates (v1 concept, kept until phase 2
// introduces Applications).
model Service {
  id                  String    @id @default(cuid())
  containerId         String    @unique
  containerName       String
  image               String // full image ref e.g. ghcr.io/org/repo:tag
  registry            String    @default("ghcr.io")
  currentDigest       String    @default("")
  repoDigests         String    @default("") // comma-separated RepoDigests of the local image
  remoteDigest        String    @default("")
  tag                 String    @default("latest")
  isFloatingTag       Boolean   @default(true) // true = auto-update, false = notify only
  arch                String    @default("amd64")
  status              String    @default("unknown") // running, stopped, updating, error
  updateAvailable     Boolean   @default(false)
  endpointId          String?
  endpoint            Endpoint? @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  portainerEndpointId Int       @default(1) // v1 legacy
  lastChecked         DateTime?
  lastUpdated         DateTime?
  lastHealthRestart   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([endpointId])
}

model HealthMonitor {
  id          String  @id @default("singleton")
  enabled     Boolean @default(false)
  prefixes    String  @default("") // newline-separated; empty = match all containers
  logWindow   Int     @default(300) // seconds of recent logs to scan per cycle
  cooldown    Int     @default(10) // minutes between restarts per container
  logPatterns String  @default("connection timeout\nconnection refused\nconnection reset\nconnection timed out\nunable to connect\npool exhausted\ntoo many connections\nout of memory\nheap out of memory\noom killer\nkilled process\nmemory limit exceeded\nfatal error\npanic:\nsegfault\nsegmentation fault\ncore dumped\nunhandled exception\ndeadlock detected\nhealth check failed\nno space left\ni/o error\nread-only file system")
}

// ─── Audit ────────────────────────────────────────────────────────────────────

// Who did what, where. Replaces ActivityLog (kept below for the one-time copy).
model AuditEvent {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorType  String   @default("system") // user, system
  actorId    String?
  actorEmail String   @default("")
  action     String // e.g. auth.login, container.restart, service.update
  targetType String   @default("")
  targetId   String   @default("")
  endpointId String?
  serviceId  String?
  ip         String   @default("")
  outcome    String   @default("success") // success, failure
  message    String
  details    String   @default("")

  @@index([createdAt])
  @@index([action])
  @@index([endpointId])
}

// v1 legacy — copied into AuditEvent by the v2 upgrade step, no longer written
model ActivityLog {
  id        String   @id @default(cuid())
  serviceId String?
  action    String
  message   String
  details   String   @default("")
  createdAt DateTime @default(now())
}

// ─── Apps (phase 2) ───────────────────────────────────────────────────────────

model Project {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  description  String        @default("")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  environments Environment[]
}

model Environment {
  id                String        @id @default(cuid())
  projectId         String
  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name              String // production, staging, …
  slug              String
  defaultEndpointId String?
  defaultEndpoint   Endpoint?     @relation(fields: [defaultEndpointId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  applications      Application[]

  @@unique([projectId, slug])
}

model Application {
  id                  String      @id @default(cuid())
  environmentId       String
  environment         Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  endpointId          String
  endpoint            Endpoint    @relation(fields: [endpointId], references: [id])
  name                String
  // Docker-safe name, unique per endpoint: used for containers, compose project, volumes
  slug                String
  sourceType          String // image, git-dockerfile, git-compose, compose
  image               String      @default("") // image apps: ghcr.io/org/app:tag
  gitRepo             String      @default("") // https URL
  gitBranch           String      @default("main")
  buildContext        String      @default(".")
  dockerfilePath      String      @default("Dockerfile")
  composePath         String      @default("docker-compose.yml")
  composeInline       String      @default("") // compose apps without Git
  // JSON settings for image / Dockerfile apps
  // [{key, value, kind}] kind: plain; secret (value AES-256-GCM encrypted, never sent back to the browser);
  // vault (value = <mount>/<path>#<field>, read from Vault at deploy time).
  // Image/Dockerfile apps get them as container env; compose apps for ${VAR} interpolation.
  env                 String      @default("[]")
  ports               String      @default("[]") // [{host, container, protocol}]
  volumes             String      @default("[]") // [{name, path}] named volumes
  command             String      @default("")
  restartPolicy       String      @default("unless-stopped")
  updatePolicy        String      @default("manual") // manual, auto-digest, on-push
  webhookSecret       String      @default("") // encrypted; GitHub push webhook HMAC secret
  status              String      @default("new") // new, deploying, running, failed, stopped
  currentDeploymentId String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  deployments Deployment[]
  domains     Domain[]

  @@unique([endpointId, slug])
  @@index([environmentId])
}

model Deployment {
  id              String      @id @default(cuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  trigger         String // manual, push, digest, rollback, redeploy
  status          String      @default("queued") // queued, running, success, failed, cancelled
  commitSha       String      @default("")
  commitMessage   String      @default("")
  imageRef        String      @default("") // image the app runs, digest-pinned when known
  imageDigest     String      @default("")
  renderedCompose String      @default("") // compose apps: rendered file, secret values NOT included
  envSnapshot     String      @default("[]") // app env at deploy time, secret values still encrypted; used by rollbacks
  containerIds    String      @default("") // comma-separated containers started by this deployment
  error           String      @default("")
  startedById     String?
  startedByEmail  String      @default("")
  rollbackOfId    String?
  createdAt       DateTime    @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?

  @@index([applicationId, createdAt])
}

model Domain {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  host          String
  path          String      @default("/")
  containerPort Int
  service       String      @default("") // compose apps: which service receives the traffic
  https         Boolean     @default(true) // Let's Encrypt via HTTP challenge
  createdAt     DateTime    @default(now())

  @@unique([host, path])
}

// ─── Ops ──────────────────────────────────────────────────────────────────────

model Job {
  id         String    @id @default(cuid())
  type       String // deploy, secrets-refill
  payload    String    @default("{}")
  status     String    @default("queued") // queued, running, done, failed, cancelled
  runAt      DateTime  @default(now())
  attempts   Int       @default(0)
  lockedBy   String    @default("")
  lockedAt   DateTime?
  error      String    @default("")
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([status, runAt])
}

model NotificationChannel {
  id        String   @id @default(cuid())
  name      String
  type      String // slack, discord, telegram, webhook
  config    String // encrypted JSON: url / botToken + chatId / secret
  events    String   @default("deploy.failure,deploy.success") // comma-separated
  enabled   Boolean  @default(true)
  lastError String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
