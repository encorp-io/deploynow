{
  "name": "deploynow",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && node prisma/migrate.cjs && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:migrate": "node prisma/migrate.cjs",
    "db:migration": "prisma migrate dev --create-only",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cron-parser": "^5.4.0",
    "dockerode": "^5.0.1",
    "geist": "^1.9.2",
    "jose": "^6.2.18",
    "lucide-react": "^1.7.0",
    "next": "^16.2.1",
    "next-auth": "^5.0.0-beta.30",
    "node-forge": "^1.3.1",
    "nodemailer": "^7.0.13",
    "postcss": "^8.5.8",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ssh2": "^1.17.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "ws": "^8.23.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/dockerode": "^4.0.2",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "vitest": "^4.1.2"
  },
  "prisma": {
    "seed": "node --experimental-strip-types --no-warnings prisma/seed.ts"
  },
  "overrides": {
    "next-auth": {
      "@simplewebauthn/browser": "$@simplewebauthn/browser",
      "@simplewebauthn/server": "$@simplewebauthn/server"
    }
  }
}
