{
  "title": "DeployNow containers",
  "uid": "deploynow-containers",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "deploynow"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "endpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(deploynow_endpoint_up, endpoint)",
          "refId": "endpoint"
        },
        "definition": "label_values(deploynow_endpoint_up, endpoint)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(deploynow_container_memory_usage_bytes, project)",
          "refId": "project"
        },
        "definition": "label_values(deploynow_container_memory_usage_bytes, project)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "app",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(deploynow_container_memory_usage_bytes{project=~\"$project\"}, app)",
          "refId": "app"
        },
        "definition": "label_values(deploynow_container_memory_usage_bytes{project=~\"$project\"}, app)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU (100% = one core)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(deploynow_container_cpu_usage_seconds_total{endpoint=~\"$endpoint\",project=~\"$project\",app=~\"$app\"}[5m]) * 100",
          "legendFormat": "{{app}} {{service}} {{container}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "deploynow_container_memory_usage_bytes{endpoint=~\"$endpoint\",project=~\"$project\",app=~\"$app\"}",
          "legendFormat": "{{app}} {{service}} {{container}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Network in",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(deploynow_container_network_receive_bytes_total{endpoint=~\"$endpoint\",project=~\"$project\",app=~\"$app\"}[5m])",
          "legendFormat": "{{app}} {{service}} {{container}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Network out",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(deploynow_container_network_transmit_bytes_total{endpoint=~\"$endpoint\",project=~\"$project\",app=~\"$app\"}[5m])",
          "legendFormat": "{{app}} {{service}} {{container}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Disk read",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(deploynow_container_blkio_read_bytes_total{endpoint=~\"$endpoint\",project=~\"$project\",app=~\"$app\"}[5m])",
          "legendFormat": "{{app}} {{service}} {{container}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Disk write",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(deploynow_container_blkio_write_bytes_total{endpoint=~\"$endpoint\",project=~\"$project\",app=~\"$app\"}[5m])",
          "legendFormat": "{{app}} {{service}} {{container}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Host memory used",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "deploynow_host_memory_used_bytes{endpoint=~\"$endpoint\"} / deploynow_host_memory_total_bytes{endpoint=~\"$endpoint\"}",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Host disk used",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "deploynow_host_disk_used_bytes{endpoint=~\"$endpoint\"} / deploynow_host_disk_total_bytes{endpoint=~\"$endpoint\"}",
          "legendFormat": "{{endpoint}}"
        }
      ]
    }
  ]
}